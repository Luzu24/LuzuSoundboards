{
  "name": "luzu-soundboards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "vite --mode development",
    "electron:build": "tsc -b && vite build && electron-builder"
  },
  "build": {
    "appId": "com.luzu.soundboards",
    "productName": "LuzuSoundboards",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LuzuSoundboards",
      "installDirectory": "C:\\Program Files\\LuzuSoundboards"
    },
    "portable": {
      "artifactName": "LuzuSoundboards-Portable-${version}.exe"
    }
  }
}